# Copy this to .env.local and fill in your values.
# Expo reads EXPO_PUBLIC_* vars at build time and makes them available in the app.

# Firebase (same project as the web app — use the same values)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ClassCapsule API — your deployed Vercel URL (no trailing slash)
# For local development: set this to your machine's LAN IP, e.g. http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=https://classcapsule.vercel.app
